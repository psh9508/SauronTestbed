SAURON_BASE_URL=http://127.0.0.1:8002
# register_repo.py 로 저장소 등록 후 발급된 public_key
SAURON_REPOSITORY_KEY=
# GitLab 저장소일 때만 필요 (예: https://gitlab.example.com/group/sauron-testbed)
SAURON_REPOSITORY_URL=
# 실행 중인 코드의 커밋 SHA (sentry release로 전송). 비우면 Sauron이 default branch 기준으로 소스를 읽는다
# 예: GIT_COMMIT_SHA=$(git rev-parse HEAD)
GIT_COMMIT_SHA=
